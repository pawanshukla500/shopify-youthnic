generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Orders synced from Shopify ───────────────────────────
model Order {
  id                 Int    @id @default(autoincrement())
  // Shopify order ID (GraphQL gid or REST id)
  shopifyOrderId     String @unique
  shopifyOrderName   String // e.g. #1001
  shopifyOrderNumber Int

  // Customer details
  customerName    String
  customerPhone   String // E.164 format, e.g. 919999999999
  customerEmail   String?
  customerAddress String
  customerCity    String
  customerState   String
  customerPincode String
  customerCountry String  @default("India")

  // Order details
  totalAmount       Float
  totalShipping     Float?
  totalDiscounts    Float?
  totalTax          Float?
  totalOutstanding  Float?
  taxesIncluded     Boolean?
  taxLines          Json?
  discountCodes     Json?
  shippingTitle     String?
  shopifyNote       String?
  additionalDetails Json?
  currency          String  @default("INR")
  paymentMethod     String? // COD, prepaid, etc.
  financialStatus   String? // paid, pending, refunded, etc.
  fulfillmentStatus String? // fulfilled, unfulfilled, etc.
  tags              String? // Shopify order tags, e.g. "GoKwik, PREPAID-DISCOUNT, UPI"

  // Where the order came from. Shopify reports this as an app/channel, e.g.
  // "web" for the online store or a numeric app id for a checkout app.
  sourceName   String? // raw Shopify source_name ("web", "249596116993")
  salesChannel String? // resolved name ("Online Store", "Youthnic <> Gokwik")

  // Payment gateway tracking (GoKwik, Easebuzz, PhonePe, etc.)
  paymentGateway            String? // gokwik, phonepe, shopify_payments, etc.
  paymentAggregator         String? // e.g. "GoKwik" (checkout aggregator)
  paymentProvider           String? // e.g. "Easebuzz", "PhonePe" (the actual partner receiving the funds)
  paymentProviderPaymentId  String? // e.g. "E26092416XTT5X" (Easebuzz payment ID)
  gokwikPaymentId           String? // e.g. "KWIKKFZJVFXO7380932MP"
  gatewayTransactionId      String? // transaction ID from the gateway (e.g. #26YOU5754.1)
  paymentAuthorizationKey   String? // authorization key from gateway (e.g. KWIK001VLQBP7380871)
  paymentVerified           Boolean   @default(false) // true after payment confirmed for prepaid orders
  paymentVerifiedAt         DateTime?
  paymentVerificationSource String? // shopify_transaction, gokwik_easebuzz, phonepe_api
  paymentReference          String? // merchant transaction reference / UTR at gateway (e.g. 614686239240)

  // Our internal status
  status OrderStatus @default(NEW)

  // Logistics cost & audit against Delhivery Wallet Ledger
  actualShippingCost    Float?  @default(0) // Net actual debited logistics cost (e.g. 333.57)
  shippingAudited       Boolean @default(false) // True when reconciled against Delhivery ledger
  weightDiscrepancy     Boolean @default(false) // True if Delhivery machine captured higher weight
  weightDiscrepancyNote String? // Explanation of weight mismatch & re-bill

  // GoKwik RTO prediction & risk analysis
  deliverOrderCount Int? // Number of prior successful deliveries on GoKwik network (e.g. 2, 9)
  rtoRiskLevel      String? // LOW, MEDIUM, HIGH
  rtoRiskReason     String? // Reason from GoKwik / WhatsApp verification

  // Dispatch SLA tracking
  expectedDispatchAt DateTime? // Expected dispatch deadline (default: shopifyCreatedAt + 24 hours)
  dispatchDelayed    Boolean   @default(false) // True if overdue past expectedDispatchAt

  // Timestamps
  shopifyCreatedAt DateTime
  shopifyUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  dispatchedAt     DateTime? // Set when createShipment succeeds on Delhivery (AWB assigned, label printed)
  // Claimed by dispatchOrder for the length of one Delhivery manifest call, so
  // a double click, bulk dispatch and the sync auto-dispatch cannot manifest the
  // same order twice. A claim older than a few minutes is treated as abandoned.
  dispatchLockedAt DateTime?
  deliveredAt      DateTime? // Set when Delhivery reports delivery
  cancelledAt      DateTime? // Set when the order is cancelled

  // ─── Accounts reconciliation ───
  // Money actually credited to Youthnic's bank for this order. Prepaid: the
  // payment-gateway settlement (PhonePe / Easebuzz / GoKwik). COD: the Delhivery
  // remittance. Filled from uploaded reports or the gateway settlement APIs.
  paymentReceivedAt     DateTime?
  paymentReceivedAmount Float? // net amount credited for this order
  paymentReceivedUtr    String? // bank UTR of the credit
  paymentReceivedRef    String? // settlement id / Delhivery remittance number
  paymentReceivedSource String? // DELHIVERY_REMITTANCE | PG_SETTLEMENT_REPORT | PHONEPE_SETTLEMENT_API | EASEBUZZ_PAYOUT_API | MANUAL
  gatewayFee            Float? // gateway fee + GST deducted from a prepaid settlement
  // Set once the order is delivered, its payment is in the bank and the
  // return window has passed with no open return ("Payment Received" tab).
  accountsClosedAt      DateTime?

  // Urgent Customer Support & Return Flagging
  hasUrgentSupport Boolean @default(false)
  supportFlag      String? // e.g. "URGENT_DAMAGE_CLAIM", "RETURN_WINDOW_EXPIRING", "DELAY_COMPLAINT"

  // Relations
  items         OrderItem[]
  shipment      Shipment?
  returns       Return[]
  accountTrailEvents AccountTrailEvent[]
  notifications Notification[]
  syncLogs      SyncLog[]
  emailLogs     EmailLog[]
  inboundEmails InboundEmail[]

  @@index([status])
  @@index([shopifyUpdatedAt])
  // Order lists filter by status and order by shopifyCreatedAt desc (order.service
  // getOrders / autoDispatchPendingOrders / reconcilePendingChannelOrders).
  @@index([status, shopifyCreatedAt])
  // Monthly / date-range accounts reports range-scan on shopifyCreatedAt.
  @@index([shopifyCreatedAt])
  // Accounts maintenance: backfillDeliveredAt (deliveredAt IS NULL) and
  // closeSettledOrders (deliveredAt <= return-window cutoff) run on the hourly cron.
  @@index([deliveredAt])
  // closeSettledOrders scans accountsClosedAt IS NULL candidates hourly.
  @@index([accountsClosedAt])
  // Hourly RTO-refund retry cron filters supportFlag = 'RTO_REFUND_FAILED'.
  @@index([supportFlag])
  // Dashboard payment aggregates and the daily COD refund digest filter by
  // paymentMethod + status (api.ts /payments/summary, return-scan digest).
  @@index([paymentMethod, status])
  // /payments/summary unverified count and the orders list paymentVerified filter.
  @@index([paymentVerified, status])
  // Reconciliation uploads and return-scan sync look orders up by exact order
  // name (#1001 / 1001 variants) — reconciliation.service findOrderByReference.
  @@index([shopifyOrderName])
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shopifyVariantId String?
  sku              String?
  title            String
  variantTitle     String?
  imageUrl         String?
  quantity         Int
  price            Float
  // Whether this item is eligible for return
  returnable       Boolean @default(true)

  // Relations
  returns ReturnItem[]

  @@index([orderId])
}

// ─── Shipments via Delhivery ──────────────────────────────
model Shipment {
  id      Int   @id @default(autoincrement())
  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Delhivery details
  waybillNumber    String? @unique // AWB number from Delhivery
  orderIdDelhivery String? // Delhivery's internal order ID
  courier          String?
  pickupBatchKey   String?
  manifestedByOms Boolean @default(false)
  manifestPickupLocation String?
  omsManifestedAt DateTime?
  pickupBatch      WarehousePickupBatch? @relation(fields: [pickupBatchKey], references: [key], onDelete: SetNull)
  paymentMode      String? // COD / Pre-paid
  codAmount        Float?  @default(0)
  declaredValue    Float?

  // COD reconciliation. Delhivery's public API exposes no remittance endpoint,
  // so "collected" is derived from delivery status (the courier takes the cash
  // at delivery) while "remitted" is recorded from the Delhivery panel report
  // under Finances > Remittance. Comparing the two shows what is still owed.
  codCollected      Boolean   @default(false)
  codCollectedAt    DateTime?
  codRemitted       Boolean   @default(false)
  codRemittedAt     DateTime?
  codRemittanceRef  String? // Delhivery remittance number
  codRemittedAmount Float? // amount actually credited, may differ from codAmount

  // Shipment status
  status ShipmentStatus @default(PENDING)

  // Tracking
  trackingStatus    String? // Latest status from Delhivery
  trackingLocation  String?
  trackingUpdatedAt DateTime?
  expectedDeliveryDate DateTime? // Delhivery ExpectedDeliveryDate / PromisedDeliveryDate
  trackingHistory   Json? // Full tracking timeline

  // Label
  labelUrl String? // External Delhivery PDF label URL (kept for fallback)

  // Firebase Storage artifacts — uploaded by delhiveryDocumentFetcher cron
  labelStoragePath     String? // gs://bucket/orders/{orderId}/label-{ts}.pdf
  epodStoragePath      String? // gs://bucket/orders/{orderId}/epod-{ts}.jpg
  epodReceivedBy       String? // Consignee name from POD
  epodReceivedAt       DateTime? // Delivery timestamp captured in POD
  signatureStoragePath String? // gs://bucket/orders/{orderId}/signature-{ts}.jpg
  sorterStoragePath    String? // gs://bucket/orders/{orderId}/sorter-{ts}.jpg
  sorterCapturedAt     DateTime? // Timestamp of sorter capture
  sorterWeightGrams    Float? // Weight measured by sorter (overrides billedWeightGrams when present)

  // Actual Delhivery Billed Charges & Weight Audit (from Wallet Ledger)
  declaredWeightGrams Float?    @default(400) // Initial declared weight when shipment manifested (e.g. 400 gm)
  billedWeightGrams   Float? // Weight captured by Delhivery hub (e.g. 2450.2 gm)
  chargedZone         String? // Zone billed (e.g. D1, E, B)
  initialCost         Float?    @default(0) // Initial debit at manifestation (e.g. 70.22)
  reversalAmount      Float?    @default(0) // Amount credited back upon machine re-weighment (e.g. 70.22)
  revisedCost         Float?    @default(0) // New debit after machine re-weighment (e.g. 333.57)
  hasReversal         Boolean   @default(false) // True if Delhivery reversed and recharged
  reversalReason      String? // Description of reversal e.g. "Captured weight is higher than declared weight"
  totalDebited        Float?    @default(0) // Total wallet debits for this AWB (e.g. 403.79)
  totalCredited       Float?    @default(0) // Total wallet credits for this AWB (e.g. 70.22)
  netBilledCost       Float?    @default(0) // Actual net cost = debits - credits (e.g. 333.57)
  weightMismatch      Boolean   @default(false) // Captured weight > declared weight
  mismatchDetails     String? // e.g. "Captured 2450.2 gm vs Declared 400 gm (+2050.2 gm)"
  billingStatus       String?   @default("ESTIMATED") // ESTIMATED, MANIFESTED, BILLED, AUDITED, WEIGHT_MISMATCH, REBILLED
  lastBilledAt        DateTime?

  // Detailed wallet ledger transactions from Delhivery WalletReport (Debits & Refunds)
  // Array of { txnId, date, type: 'debit' | 'credit', amount: number, description: string, status: string, zone?: string, weight?: number, closureDate?: string }
  walletTransactions  Json?

  // Shipping cost per leg, GST included. ESTIMATE comes from Delhivery's
  // rate API; ACTUAL replaces it when the wallet ledger / invoice backup that
  // lists this AWB is uploaded. Null = not known yet.
  forwardCharge         Float?
  rtoCharge             Float? // return-to-origin leg, only for RTO parcels
  shippingCostSource    String? // forward leg: ESTIMATE | ACTUAL
  rtoChargeSource       String? // RTO leg: ESTIMATE | ACTUAL (legs are billed and uploaded separately)
  shippingCostUpdatedAt DateTime?

  // Error/retry
  errorMessage String?
  retryCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  trackingLogs TrackingLog[]

  @@index([status])
  @@index([waybillNumber])
  // Tracking cron (every 30 min) batches live shipments by status, ordered by
  // trackingUpdatedAt asc (nulls first) with a stale-before cutoff.
  @@index([status, trackingUpdatedAt])
  // COD ledger dashboard: aggregates and outstanding lists filter
  // paymentMode = 'COD' with codCollected / codRemitted flags.
  @@index([paymentMode, codCollected, codRemitted])
}

// NOTE: DelhiveryLedgerTransaction removed 2026-09-28 — Delhivery has no
// wallet/ledger API (manual CSV was not useful). Wallet lives in the ONE
// panel only. Deploy runs `prisma db push`, which will drop the table.

model TrackingLog {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status    String
  location  String?
  remark    String?
  scannedAt DateTime

  // Delhivery official payload enrichment
  // (https://one.delhivery.com/developer-portal/document/b2c/detail/webhook_functionality)
  statusType   String? // UD | DL | RT | PP | PU | CN
  rawStatus    String? // e.g. "Delivered", "Manifested"
  instructions String? // e.g. "Manifest uploaded"
  pickupDate   DateTime? // PickUpDate from payload
  nslCode      String? // Network Serviceability code e.g. X-UCI
  sortCode     String? // Hub sort code e.g. IXC/MDP
  referenceNo  String? // Reference number from Delhivery
  receivedBy   String? // Consignee name on delivery
  waybill      String? // Cached for idempotency dedup

  createdAt DateTime @default(now())

  // Webhook-retry idempotency: same waybill + status + scannedAt must dedupe.
  // Earlier scans are kept via upsert so retries don't duplicate history rows.
  @@unique([waybill, status, scannedAt], name: "waybill_status_time")
  @@index([shipmentId])
  @@index([waybill])
}

// ─── Returns ──────────────────────────────────────────────
model Return {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Shopify return ID if synced
  shopifyReturnId String?

  // Return details
  returnReason String
  returnStatus ReturnStatus @default(INITIATED)

  // Return shipment (reverse logistics via Delhivery).
  // A real Delhivery AWB — never a placeholder. Customer pickup is scheduled
  // by Delhivery when the reverse order is manifested (payment_mode Pickup).
  returnWaybillNumber  String?
  returnShipmentStatus String?
  forwardWaybill       String? // Delivered forward AWB this return was raised against
  carrier              String?   @default("Delhivery")
  pickupAutomatic      Boolean   @default(true)
  trackingStatus       String?
  trackingLocation     String?
  trackingUpdatedAt    DateTime?
  trackingHistory      Json?
  labelUrl             String?
  pickedUpAt           DateTime?
  receivedAt           DateTime?

  // Refund
  refundStatus      RefundStatus @default(NONE)
  refundAmount      Float?
  shopifyRefundId   String?
  refundProcessedAt DateTime?
  // Failed refund attempts. The hourly retry stops at the cap and leaves the
  // return for a person instead of retrying forever.
  refundAttempts    Int          @default(0)

  // Quality check on returned goods
  qcStatus    QcStatus? // set when return is scanned/delivered back
  qcRemark    String?
  qcCheckedAt DateTime?

  // Firebase Storage artifact — uploaded by delhiveryDocumentFetcher cron
  qcStoragePath String? // gs://bucket/orders/{orderId}/qc-{ts}.jpg

  // Reverse-pickup shipping cost, GST included (ESTIMATE until ACTUAL is uploaded)
  shippingCharge     Float?
  shippingCostSource String? // ESTIMATE | ACTUAL

  // WhatsApp notification for return
  customerNotified Boolean @default(false)

  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  items         ReturnItem[]
  accountTrailEvents AccountTrailEvent[]
  notifications Notification[]

  @@index([returnStatus])
  @@index([refundStatus])
  @@index([returnWaybillNumber])
  // FK index (not automatic for one-to-many): returns are loaded per order on
  // order detail, accounts closing, and the COD refund digest.
  @@index([orderId])
  // Reverse-tracking cron batches open returns by status, ordered by
  // trackingUpdatedAt with a stale-before cutoff (return.service syncActiveReturns).
  @@index([returnStatus, trackingUpdatedAt])
  // Hourly retryFailedRefunds cron: refundStatus = FAILED and
  // refundAttempts < cap.
  @@index([refundStatus, refundAttempts])
}

// One open warehouse pickup per location per day. Delhivery's pickup API
// (POST /fm/request/new/) is for forward parcels at the registered warehouse.
// Reverse customer pickups are scheduled by the reverse manifest itself.
model PickupRequest {
  id                    Int      @id @default(autoincrement())
  pickupId              String?
  pickupLocation        String
  pickupDate            String
  pickupTime            String
  expectedPackageCount  Int
  direction             String   @default("FORWARD")
  status                String // SCHEDULED | ALREADY_OPEN | FAILED
  message               String?
  rawResponse           Json?
  createdAt             DateTime @default(now())

  @@index([pickupLocation, pickupDate])
  @@index([status])
}

// Unique only on this new table; existing pickup history is left intact.
model WarehousePickupBatch {
  key                   String   @id
  pickupLocation        String
  pickupDate            String
  pickupTime            String
  status                String   @default("QUEUED")
  pickupId              String?
  submittedPackageCount Int      @default(0)
  attempts              Int      @default(0)
  claimedAt             DateTime?
  nextAttemptAt         DateTime @default(now())
  message               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  shipments             Shipment[]

  @@index([status, nextAttemptAt])
}

model ReturnItem {
  id        Int    @id @default(autoincrement())
  returnId  Int
  returnObj Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity Int
  qcStatus QcStatus?
  qcRemark String?
}

// Immutable account/refund audit trail. Actor fields are snapshots from the
// authenticated request so history remains readable if a user account changes.
// Evidence paths point to private Firebase Storage objects, never public URLs.
model AccountTrailEvent {
  id       Int  @id @default(autoincrement())
  orderId  Int
  order    Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnId Int?
  returnObj Return? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  eventType String // COD_APPROVED | RETURN_CREATED | REFUND_AUTOMATIC | REFUND_MANUAL
  actorType String // USER | SYSTEM
  actorUid  String?
  actorEmail String?
  actorName String?
  actorRole String?
  source    String? // OMS_UI | RETURN_QC | RTO_AUTO_REFUND | SHOPIFY | MANUAL_PAYOUT
  status    String? // COMPLETED | NO_MONEY_MOVED | FAILED

  amount            Float?
  currency          String? @default("INR")
  refundMode        String? // ORIGINAL_PAYMENT_METHOD | UPI | BANK_TRANSFER | CASH | OTHER
  accountUsed       String?
  externalReference String? // Shopify refund ID, UTR, or payout reference
  note              String?

  evidenceStoragePath  String?
  evidenceFileName     String?
  evidenceContentType  String?
  metadata             Json?
  createdAt            DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([returnId, createdAt])
  @@index([eventType, createdAt])
  @@unique([orderId, eventType, externalReference], map: "AccountTrailEvent_refund_dedupe_key")
}

// ─── WhatsApp Notifications ───────────────────────────────
model Notification {
  id        Int     @id @default(autoincrement())
  orderId   Int?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnId  Int?
  returnObj Return? @relation(fields: [returnId], references: [id], onDelete: Cascade)

  type              NotificationType
  recipient         String // phone number
  templateName      String?
  messageBody       String?
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([orderId])
  @@index([status])
}

// ─── Customer Email Communications & Conversion Logs ──────
model EmailLog {
  id                   Int     @id @default(autoincrement())
  orderId              Int?
  order                Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shopifyOrderName     String? // e.g. #26YOU5752
  recipientEmail       String
  recipientName        String?
  subject              String
  templateType         String // TRANSIT_DELAY, DISPATCH_DELAY, IN_TRANSIT, OUT_FOR_DELIVERY, NDR_ALERT, DELIVERED, ORDER_CONFIRMED, CUSTOM
  status               String  @default("PENDING") // SENT, DELIVERED, FAILED, SIMULATED
  resendId             String? // ID returned by Resend API
  waybillNumber        String? // Delhivery AWB
  courier              String? @default("Delhivery Express")
  currentLocation      String?
  delayReason          String?
  expectedDeliveryDate String?
  htmlPreview          String? @db.Text
  errorMessage         String?

  // Conversion & Engagement Tracking
  converted        Boolean   @default(false)
  conversionAction String? // TRACKING_CLICKED, DELIVERY_CONFIRMED, ADDRESS_CONFIRMED, RTO_PREVENTED
  conversionAt     DateTime?
  openCount        Int       @default(0)
  clickCount       Int       @default(0)
  lastEngagedAt    DateTime?

  metadata  Json?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([orderId])
  @@index([recipientEmail])
  @@index([templateType])
  @@index([status])
  @@index([converted])
  @@index([createdAt])
  // Transit-delay cooldown check runs per shipment on every tracking poll:
  // orderId + templateType + createdAt >= 24h ago (tracking.service).
  @@index([orderId, templateType, createdAt])
}

// ─── Inbound Customer Support Emails & AI Triage ──────────
model InboundEmail {
  id               Int       @id @default(autoincrement())
  orderId          Int?
  shopifyOrderId   String?
  shopifyOrderName String?
  fromEmail        String
  fromName         String?
  toEmail          String    @default("return@youthnic.com")
  subject          String
  bodyText         String?   @db.Text
  bodyHtml         String?   @db.Text
  category         String // RETURN_REQUEST, EXCHANGE_REQUEST, TRANSIT_DELAY, DAMAGED_ITEM, CANCELLATION, GENERAL_INQUIRY
  urgency          String // URGENT, HIGH, NORMAL, LOW
  sentiment        String    @default("NEUTRAL") // FRUSTRATED, URGENT, NEUTRAL, POSITIVE
  flagReason       String?
  aiAnalysis       Json?
  suggestedReply   String?   @db.Text
  status           String    @default("OPEN") // OPEN, IN_REVIEW, REPLIED, RESOLVED, CLOSED
  replyText        String?   @db.Text
  repliedAt        DateTime?
  resolvedBy       String?
  channel          String    @default("EMAIL") // EMAIL, WHATSAPP
  firebaseRtdbPath String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([fromEmail])
  @@index([urgency])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

// ─── Self-Learning Knowledge Base & Pattern Cache ────────
model SupportKnowledgePattern {
  id                 Int      @id @default(autoincrement())
  patternKey         String   @unique
  intent             String
  keywords           String // Comma-separated triggers
  recommendedUrgency String // URGENT, HIGH, NORMAL
  suggestedAction    String
  autoReplyTemplate  String   @db.Text
  confidence         Float    @default(1.0)
  usageCount         Int      @default(0)
  isLearned          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([patternKey])
  @@index([intent])
}

// ─── Sync Logs ────────────────────────────────────────────
model SyncLog {
  id      Int    @id @default(autoincrement())
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  syncType     SyncType
  status       SyncLogStatus
  message      String?
  payload      Json?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([syncType])
  @@index([status])
  // Hourly RTO-refund retry counts failures per order
  // (orderId + syncType + status) inside its retry loop.
  @@index([orderId, syncType, status])
}

// ─── Accounts: uploaded reconciliation files ──────────────
// One row per uploaded Delhivery remittance / charges file or gateway
// settlement report, so the accounts team can see what was matched.
model ReconciliationImport {
  id           Int      @id @default(autoincrement())
  kind         String // DELHIVERY_REMITTANCE | DELHIVERY_CHARGES | PG_SETTLEMENT
  fileName     String
  rowCount     Int
  matchedCount Int
  unmatched    Json? // identifiers in the file that matched no order / AWB
  summary      Json?
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}

// ─── Settings (key-value store for runtime config) ────────
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Enums ────────────────────────────────────────────────
enum OrderStatus {
  NEW // Just synced from Shopify, not yet processed
  DISPATCH_PENDING // Ready to be pushed to Delhivery
  DISPATCHED // AWB generated, label printed
  SHIPPED // Picked up by courier
  IN_TRANSIT // In transit
  OUT_FOR_DELIVERY // Out for delivery
  DELIVERED // Delivered to customer
  FAILED_DELIVERY // Delivery failed / NDR
  RTO_INITIATED // Return to origin initiated
  RTO_DELIVERED // Returned back to seller
  RETURN_REQUESTED // Customer requested return
  RETURN_DISPATCHED // Return shipment dispatched
  RETURN_RECEIVED // Return received at warehouse (scanned)
  REFUNDED // Refund processed
  CANCELLED // Order cancelled
}

enum ShipmentStatus {
  PENDING // Created in our system, not yet pushed to Delhivery
  CREATED // Pushed to Delhivery, AWB generated
  PICKED_UP // Picked up by courier
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED // Delivery failed
  RTO // Return to origin
  RTO_DELIVERED
  CANCELLED // Cancelled before dispatch
