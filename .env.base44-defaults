# Base44 dev defaults — placeholders only, overridden by /run/base44/app.env
# Do not put real credentials here; they belong in the Base44 secrets dashboard.

NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# Required at boot — placeholders so the app starts without real credentials.
# Replace via the Base44 secrets dashboard.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
DELHIVERY_PICKUP_LOCATION=YOUR_REGISTERED_WAREHOUSE_NAME

# Disable cron jobs in dev to avoid hitting unconfigured external APIs.
CRON_ENABLED=false

# Shopify API version
SHOPIFY_API_VERSION=2026-07
