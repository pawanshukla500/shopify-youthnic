# Template only — placeholders, never real values.
# Copy to .env (which is gitignored) and fill it in there.

# ══════════════════════════════════════════════
# REQUIRED — the app will not start without these
# ══════════════════════════════════════════════

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Public HTTPS URL of this service. Shopify webhooks are registered against it.
APP_BASE_URL=https://your-app.example.com

DATABASE_URL=postgresql://user:password@host:5432/shopify?sslmode=require

# ── Return Scan Database (Read-only warehouse scan connection) ──
# Strictly accessed in read-only mode to detect RTO/return scans and deliver/refund orders.
RETURN_SCAN_DATABASE=postgresql://user:password@host:5432/return-scan_youthnic?sslmode=require
COD_REFUND_EMAIL=listings@vbexports.co.in

# ── Shopify (Dev Dashboard app, client credentials grant) ──
# These four are all Shopify needs. Client ID and Client Secret come from
# Dev Dashboard -> your app -> App settings -> Credentials. The OMS exchanges
# them for a 24-hour access token and refreshes it automatically, and Shopify
# signs webhooks with the client secret, so no separate token or webhook
# secret variable is required. Verify with: npm run auth:check
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# ── Delhivery ──
DELHIVERY_API_TOKEN=
# Exact registered warehouse / pickup-location name, case and space sensitive.
# This is not the client profile name ("Domestic", "B2B Surface", or "Local").
DELHIVERY_PICKUP_LOCATION=YOUR_REGISTERED_WAREHOUSE_NAME
# Origin/sender details. Must match the address registered for the pickup
# location above, because they are printed on the shipping label.
DELHIVERY_SELLER_NAME=Your Brand Name
DELHIVERY_SELLER_ADDRESS=Your Warehouse Address
DELHIVERY_SELLER_CITY=Your City
DELHIVERY_SELLER_STATE=Your State
DELHIVERY_SELLER_PINCODE=000000
DELHIVERY_SELLER_PHONE=9999999999

# ── KwikEngage WhatsApp Platform (Official GoKwik Messaging API) ──
KWIKENGAGE_API_KEY=
KWIKENGAGE_MERCHANT_ID=youthnic
KWIKENGAGE_API_URL=https://api.kwikengage.ai/send-message/v2
KWIKENGAGE_SENDER_PHONE=+91 79849 84563
KWIKENGAGE_WABA_ID=1173075567986214

# ── Resend email routing ──
# All customer replies from Youthnic sender identities are routed to this
# monitored Google Workspace inbox.
RESEND_REPLY_TO_EMAIL=contact@youthnic.com


# ══════════════════════════════════════════════
# OPTIONAL — every value below already has a working default
# in src/config/index.ts. Set one only to override it.
# ══════════════════════════════════════════════

# Shipping mode: Surface or Express
DELHIVERY_SHIPPING_MODE=Surface
# Label size: A4 or 4R (4x6 inch)
DELHIVERY_LABEL_SIZE=4R
# Accepted OMS manifests join the next IST day's warehouse batch.
# One durable batch is submitted by the 5-minute scheduler. Set false to opt out.
# Ambiguous responses require review in Delhivery ONE; they are never blindly retried.
DELHIVERY_AUTO_PICKUP=true
DELHIVERY_PICKUP_TIME=14:00:00

# ── Multi-Carrier Shipping & Velocity Shipping ──
# Carrier priority: DELHIVERY_FIRST (default) or VELOCITY_FIRST
SHIPPING_CARRIER_PRIORITY=DELHIVERY_FIRST
# Velocity Shipping API token (from Velocity dashboard -> Settings -> API)
VELOCITY_API_TOKEN=
VELOCITY_BASE_URL=https://shazam.velocity.in
# Registered warehouse ID in Velocity
VELOCITY_WAREHOUSE_ID=
# Velocity Webhook HMAC Secret (from Velocity dashboard -> Settings -> Webhooks)
VELOCITY_WEBHOOK_SECRET=
VELOCITY_ENABLED=true

CRON_ORDER_SYNC=*/15 * * * *
CRON_TRACKING_SYNC=*/30 * * * *
CRON_RETRY_FAILED=0 * * * *

# Earliest order creation date this OMS will import (YYYY-MM-DD, local midnight).
# Orders created before it are never imported, so a fresh database syncs from
# go-live day onward instead of pulling months of Shopify history. Orders
# already in the database keep receiving updates regardless of this date.
# Set it once before the first sync and leave it alone. Default: start of today.
# ORDER_SYNC_START_DATE=2026-09-26

# Delhivery base URLs. Production uses one URL for all B2C APIs.
# For staging, set both to https://staging-express.delhivery.com
# DELHIVERY_BASE_URL=https://track.delhivery.com
# DELHIVERY_API_BASE_URL=https://track.delhivery.com
#
# Webhook endpoints (auto-derived from APP_BASE_URL — must be public HTTPS):
#   Shopify (auto):   ${APP_BASE_URL}/webhooks/shopify — register via POST /api/setup/webhooks
#   Delhivery (manual): ${APP_BASE_URL}/webhooks/delhivery — email lastmile-integration@delhivery.com
#   WhatsApp (public):  ${APP_BASE_URL}/api/webhooks/whatsapp (GET verify + POST inbound)
# Verify with: npm run delhivery:check  +  GET /api/setup/webhooks/status
# Usage limits enforced in code:
#   track bulk 50/req · tracking cron 200/cycle + skip-fresh 10min · webhook 500/req · retry 3x
#
# KwikEngage endpoint and template names. Official API: https://api.kwikengage.ai/send-message/v2
# KWIKENGAGE_API_URL=https://api.kwikengage.ai/send-message/v2
# KWIKENGAGE_MERCHANT_ID=youthnic
# KWIKENGAGE_SENDER_PHONE=+91 79849 84563
# KWIKENGAGE_WABA_ID=1173075567986214
# KWIKENGAGE_TEMPLATE_ORDER_CONFIRMED=order_confirmed
# KWIKENGAGE_TEMPLATE_COD_CONFIRMATION=cod_confirmation
# KWIKENGAGE_TEMPLATE_ORDER_SHIPPED=order_shipped
# KWIKENGAGE_TEMPLATE_OUT_FOR_DELIVERY=out_for_delivery
# KWIKENGAGE_TEMPLATE_DELIVERED=order_delivered
# KWIKENGAGE_TEMPLATE_RETURN_INITIATED=return_initiated
# KWIKENGAGE_TEMPLATE_REFUND_PROCESSED=refund_processed
# KWIKENGAGE_TEMPLATE_NDR=ndr_attempt
#
# Seconds before expiry at which the cached Shopify token is refreshed.
# SHOPIFY_TOKEN_REFRESH_SKEW=300
#
# Only for a legacy admin-created custom app, which can no longer be created.
# When set, this static token is used instead of the client credentials grant,
# and this app's own webhook secret must then be supplied too.
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_WEBHOOK_SECRET=


# ══════════════════════════════════════════════
# GoKwik Payment Gateway & Integrated Refund API
# ══════════════════════════════════════════════
# GoKwik API credentials from Merchant Dashboard / Postman doc (2sAYX2N4ik)
# Order Status API: POST /v3/orders/fetch (gk-app-id, gk-app-secret)
# Integrated Refund API: POST /v3/orders/update (merchant_order_id, refund_amount, order_note)
# Webhooks: /webhooks/gokwik (payment.successful, refund.successful, refund.failure, refund.pending)
#
# GOKWIK_MERCHANT_ID=youthnic
# GOKWIK_APP_ID=
# GOKWIK_APP_SECRET=
# GOKWIK_API_URL=https://gkx.gokwik.co
# GOKWIK_STATUS_PATH=/v3/orders/fetch
# GOKWIK_REFUND_PATH=/v3/orders/update
# GOKWIK_VERIFY_ENABLED=true
#
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=1
# PHONEPE_API_URL=https://api.phonepe.com/apis/hermes
# PHONEPE_ENV=PRODUCTION
# PHONEPE_VERIFY_ENABLED=false

# ------------------------------------------------------------------------------
# Meta Model API (Muse Spark 1.3 Contributor) & Agent Harness
# ------------------------------------------------------------------------------
# Docs: https://dev.meta.ai/docs/overview?team_id=1751195342550903&project_id=1049650004728692
MODEL_API_KEY=
META_API_KEY=
META_LLM_BASE_URL=https://api.meta.ai/v1
META_LLM_MODEL=muse-spark-1.3-contributor
META_LLM_FALLBACK_MODEL=muse-spark-1.3

# Firebase Realtime Database (Agent Harness Memory & Customer History)
FIREBASE_RTDB_URL=https://shopify-134b9-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=shopify-134b9.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ── Payments & Accounts (all optional) ──
# Accounts team emails for the monthly closing report (Excel, sent on the 8th
# for the previous month's orders). Can also be set on the Payments & Accounts page.
# ACCOUNTS_REPORT_EMAILS=accounts@youthnic.com
# CRON_ACCOUNTS_REPORT=0 9 8 * *
# PhonePe Payment Gateway v2 keys (issued by PhonePe): settlement UTR per order.
# Leave empty to upload the settlement report instead.
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# Easebuzz Payout API keys: settlement UTR per transaction.
# EASEBUZZ_KEY=
# EASEBUZZ_SALT=

# ── API resilience / tracking / webhook hardening (all optional, defaults in src/config) ──
# Shared secret for Delhivery scan-push webhooks. When set, /webhooks/delhivery
# requires ?secret= or x-delhivery-secret header. Leave empty to stay open.
# DELHIVERY_WEBHOOK_SECRET=
# Bound each tracking cron cycle to avoid Delhivery 429s on large backlogs.
# TRACKING_SYNC_BATCH_LIMIT=200
# Skip shipments polled within this window (minutes). Manual sync ?force=true bypasses it.
# TRACKING_SYNC_MIN_INTERVAL_MINUTES=10